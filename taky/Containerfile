FROM python:3.12-slim

# Minimal Taky CoT server used only for AQTAK air quality reports.
# taky imports pkg_resources, which needs setuptools < 81 (slim images ship none).
RUN pip install --no-cache-dir "setuptools<81" taky && mkdir -p /var/taky /etc/taky

EXPOSE 8087/tcp

CMD ["taky", "-c", "/etc/taky/taky.conf"]
